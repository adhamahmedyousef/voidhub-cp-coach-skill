{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoidHub CP Coach progress v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "current_problem": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "topic": {
              "$ref": "#/$defs/topic_id"
            },
            "stage": {
              "enum": [
                1,
                2,
                3
              ]
            },
            "mode": {
              "enum": [
                "topic",
                "diagnostic",
                "mixed",
                "review"
              ]
            },
            "assistance": {
              "enum": [
                "none",
                "clarification",
                "observation",
                "algorithm",
                "full_solution"
              ]
            },
            "key": {
              "type": "string",
              "pattern": "^voidhub:[a-f0-9]{32}$"
            },
            "first_exposure": {
              "type": "boolean"
            }
          },
          "required": [
            "topic",
            "stage",
            "mode",
            "assistance",
            "key",
            "first_exposure"
          ],
          "additionalProperties": false
        }
      ]
    },
    "problems": {
      "type": "object",
      "propertyNames": {
        "pattern": "^voidhub:[a-f0-9]{32}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/$defs/summary"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/attempt"
            }
          }
        },
        "required": [
          "metadata",
          "attempts"
        ],
        "additionalProperties": false
      }
    },
    "mastery": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/topic_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/topic_mastery"
      },
      "required": [
        "implementation",
        "arrays_strings",
        "sorting_frequency",
        "math",
        "prefix_sums",
        "two_pointers",
        "binary_search",
        "greedy",
        "backtracking",
        "bfs_dfs",
        "dsu",
        "dijkstra",
        "dp",
        "number_theory",
        "counting",
        "bitwise",
        "monotonic_stack",
        "recursion",
        "topological_sort",
        "fenwick",
        "sparse_table",
        "segment_tree",
        "merge_sort_tree",
        "lazy_segment_tree",
        "dp_ranges",
        "digit_dp",
        "bitmask_dp",
        "rollback_dsu",
        "mst",
        "euler_tour",
        "lca",
        "dsu_on_tree",
        "kmp",
        "z_algorithm",
        "trie",
        "binary_trie",
        "hashing",
        "dynamic_hashing"
      ]
    },
    "next_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "learning": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_record"
          }
        }
      },
      "required": [
        "resources",
        "decisions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "revision",
    "current_problem",
    "problems",
    "mastery",
    "next_step",
    "learning"
  ],
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "contest": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "problem_number": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "problem_number"
          ],
          "additionalProperties": false
        },
        "difficulty": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer"
            },
            "source": {
              "const": "voidhub"
            },
            "kind": {
              "const": "archive_rating"
            }
          },
          "required": [
            "value",
            "source",
            "kind"
          ],
          "additionalProperties": false
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https://voidhub\\.co/problems/"
        }
      },
      "required": [
        "id",
        "title",
        "contest",
        "difficulty",
        "topics",
        "url"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "topic": {
          "$ref": "#/$defs/topic_id"
        },
        "stage": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "mode": {
          "enum": [
            "topic",
            "diagnostic",
            "mixed",
            "review"
          ]
        },
        "assistance": {
          "enum": [
            "none",
            "clarification",
            "observation",
            "algorithm",
            "full_solution"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "result": {
          "enum": [
            "accepted_reported",
            "solution_viewed",
            "verified_correct",
            "wrong",
            "timeout",
            "unsolved",
            "abandoned"
          ]
        },
        "failure": {
          "enum": [
            null,
            "statement",
            "recognition",
            "proof",
            "knowledge",
            "complexity",
            "implementation",
            "debugging",
            "time_management"
          ]
        },
        "transfer": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "revisit_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "topic",
        "stage",
        "mode",
        "assistance",
        "recorded_at",
        "session_id",
        "result",
        "failure",
        "transfer",
        "evidence",
        "revisit_on"
      ],
      "additionalProperties": false
    },
    "stage_evidence": {
      "type": "object",
      "properties": {
        "independent_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^voidhub:[a-f0-9]{32}$"
          }
        },
        "transfer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^voidhub:[a-f0-9]{32}$"
          }
        },
        "eligible": {
          "type": "boolean"
        }
      },
      "required": [
        "independent_ids",
        "transfer_ids",
        "eligible"
      ],
      "additionalProperties": false
    },
    "topic_mastery": {
      "type": "object",
      "properties": {
        "completed_stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "stages": {
          "type": "object",
          "properties": {
            "1": {
              "$ref": "#/$defs/stage_evidence"
            },
            "2": {
              "$ref": "#/$defs/stage_evidence"
            },
            "3": {
              "$ref": "#/$defs/stage_evidence"
            }
          },
          "required": [
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "completed_stage",
        "stages"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "topic": {
          "$ref": "#/$defs/topic_id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "pattern": "^https://(www\\.)?youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "level": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "verification": {
          "enum": [
            "metadata",
            "description",
            "transcript_excerpt"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "suggested",
            "watched",
            "skipped"
          ]
        },
        "duration_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "start_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "topic",
        "title",
        "channel",
        "url",
        "language",
        "level",
        "purpose",
        "verification",
        "verified_at",
        "status",
        "duration_seconds",
        "start_seconds"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "topic": {
          "$ref": "#/$defs/topic_id"
        },
        "stage": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "action": {
          "enum": [
            "continue",
            "advance",
            "review_prerequisite"
          ]
        },
        "target_topic": {
          "$ref": "#/$defs/topic_id"
        },
        "target_stage": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "checks": {
          "type": "object",
          "properties": {
            "understanding": {
              "type": "boolean"
            },
            "complexity": {
              "type": "boolean"
            },
            "coverage": {
              "type": "boolean"
            },
            "prerequisites": {
              "type": "boolean"
            }
          },
          "required": [
            "understanding",
            "complexity",
            "coverage",
            "prerequisites"
          ],
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      },
      "required": [
        "topic",
        "stage",
        "action",
        "target_topic",
        "target_stage",
        "checks",
        "reason"
      ],
      "additionalProperties": false
    },
    "decision_record": {
      "type": "object",
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "independent_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^voidhub:[a-f0-9]{32}$"
          },
          "uniqueItems": true
        },
        "transfer_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^voidhub:[a-f0-9]{32}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "recorded_at",
        "decision",
        "independent_ids",
        "transfer_ids"
      ],
      "additionalProperties": false
    },
    "topic_id": {
      "enum": [
        "implementation",
        "arrays_strings",
        "sorting_frequency",
        "math",
        "prefix_sums",
        "two_pointers",
        "binary_search",
        "greedy",
        "backtracking",
        "bfs_dfs",
        "dsu",
        "dijkstra",
        "dp",
        "number_theory",
        "counting",
        "bitwise",
        "monotonic_stack",
        "recursion",
        "topological_sort",
        "fenwick",
        "sparse_table",
        "segment_tree",
        "merge_sort_tree",
        "lazy_segment_tree",
        "dp_ranges",
        "digit_dp",
        "bitmask_dp",
        "rollback_dsu",
        "mst",
        "euler_tour",
        "lca",
        "dsu_on_tree",
        "kmp",
        "z_algorithm",
        "trie",
        "binary_trie",
        "hashing",
        "dynamic_hashing"
      ]
    }
  }
}
